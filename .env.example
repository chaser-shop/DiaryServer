# ── Обов’язково ──────────────────────────────────────────────
# Рядок підключення до MongoDB (локально або MongoDB Atlas). Не зберігайте справжній пароль у репозиторії.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0

# ── Основне ──────────────────────────────────────────────────
PORT=3000
# База даних застосунку (за замовчуванням navs) і база з колекцією оцінок grades (лише читання).
# DB_NAME=navs
# GRADES_DB=diary
# Повне ім’я (ПІБ) адміністратора; кілька — через кому.
ADMIN_NAMES=Прізвище Ім'я По батькові
# Пароль для входу адміністратора з нового пристрою (необов’язково).
# ADMIN_PASSWORD=
# Секрет підпису сеансів. Якщо не задано, сервер створює його сам і зберігає в базі.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# Реальна адреса для Web Push (інакше iOS відхиляє сповіщення).
VAPID_SUBJECT=mailto:you@example.com
# Часовий пояс розкладу й статистики.
# APP_TZ=Europe/Kyiv

# ── Пристрої й безпека ───────────────────────────────────────
# true — новий пристрій студента потребує підтвердження адміністратора.
# REQUIRE_DEVICE_APPROVAL=false
# Ліміт пристроїв на людину (0 — без ліміту).
# MAX_DEVICES=0
# Підвищувати власні бали можна лише з довіреного пристрою (першого або підтвердженого адміністратором).
# SCORE_EDIT_TRUSTED_DEVICES_ONLY=true

# ── Журнал успішності ────────────────────────────────────────
# Максимальний бал предмета за замовчуванням (для кожного предмета можна змінити в адмін-панелі).
# DEFAULT_MAX_SCORE=100
# Година (за APP_TZ), коли студенти отримують щоденний підсумок; у неділю — ще й тижневий.
# DIGEST_HOUR=20

# ── Google Sheets ────────────────────────────────────────────
# Таблиця, відкрита за посиланням («Усі, хто має посилання — читач»), читається без ключів.
GOOGLE_SHEET_ID=1grET3-MHCkBXqrBrHL1BIiUnAks0Kh3P4MuOijcPykY
# Аркуш (число після #gid= в адресі). Порожньо — перший аркуш.
GOOGLE_SHEET_GID=447170421
# Група, до якої належать студенти з таблиці.
GOOGLE_SHEET_GROUP=101 СПД
# Як часто перевіряти таблицю (мс, мінімум 60000).
GOOGLE_SHEET_INTERVAL_MS=300000
# Лише для приватної таблиці: JSON ключа сервісного акаунта з доступом «читач».
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Альтернатива: пряме посилання на CSV (наприклад, «Опублікувати в інтернеті»).
# GOOGLE_SHEET_CSV_URL=
# off — вимкнути синхронізацію.
# GOOGLE_SHEET_SYNC=on

# Якщо сервер стоїть за проксі (Render, Railway, Nginx) — поставте 1
# TRUST_PROXY=1
