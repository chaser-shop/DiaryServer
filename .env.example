# Рядок підключення до MongoDB (локально або MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/diary

# Довгий випадковий рядок для підпису токенів. Згенерувати:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

# true (за замовчуванням): ПІБ закріплюється за першим пристроєм, який його ввів.
# Це не дає будь-кому зайти під ПІБ адміна. Поставте false, щоб вимкнути.
BIND_DEVICE=true

# Якщо сервер стоїть за проксі (Render, Railway, Nginx) — поставте 1
# TRUST_PROXY=1
